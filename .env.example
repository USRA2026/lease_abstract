# Local Postgres (docker-compose) or Azure Database for PostgreSQL Flexible Server
DATABASE_URL="postgresql://leaseabstract:leaseabstract@localhost:5432/leaseabstract?schema=public"

# Where document binaries are stored: "local" or "azure"
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage/documents"

# Azure Blob Storage (used when STORAGE_DRIVER=azure)
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_CONTAINER="documents"
AZURE_STORAGE_CONNECTION_STRING=""

# Azure OpenAI (used for real AI abstraction + chat). Leave blank to run the
# deterministic mock provider instead, which is what this prototype ships with.
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT_CHAT="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"

# Azure AI Document Intelligence (layout/OCR extraction with bounding boxes).
# Leave blank to use the built-in text-layout extractor for the demo PDFs.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=""

# Claude API (Anthropic) — alternative to Azure OpenAI for AI abstraction +
# chat, using structured outputs so responses are schema-validated rather
# than parsed out of free text. Leave blank to run the mock provider.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# "mock" | "azure" | "claude". Leave unset to auto-detect: Azure OpenAI wins
# if AZURE_OPENAI_ENDPOINT/API_KEY are set, else Claude if ANTHROPIC_API_KEY
# is set, else mock.
AI_PROVIDER="mock"
